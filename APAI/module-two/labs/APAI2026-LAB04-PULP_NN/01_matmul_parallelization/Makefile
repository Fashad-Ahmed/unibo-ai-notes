# APPLICATION NAME
APP = matrixMul

# SOURCE FILES
APP_SRCS = main.c cluster.c matmuls.c

# NUMBER OF USED CLUSTER CORES
CORES ?= 1
N ?= 32
TRACE ?= 0
KERNEL ?= naive
UNROLL ?= 2

ifeq ($(TRACE),1)
APP_CFLAGS += -DTRACE_EXECUTION
endif

ifeq ($(KERNEL),unroll)
APP_CFLAGS += -DUSE_UNROLL
endif

# PERFORMANCE COUNTERS
APP_CFLAGS += -DPERF

# CHECK RESULT
APP_CFLAGS += -DDEBUG

# COMPILER FLAGS
APP_CFLAGS += -O3 -g3 -DNUM_CORES=${CORES} -DN=${N} -DUNROLL_FACTOR=${UNROLL} -DSTACK_SIZE=1024
APP_LDFLAGS +=

include $(RULES_DIR)/pmsis_rules.mk
